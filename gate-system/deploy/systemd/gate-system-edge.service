[Unit]
Description=Gate System Edge (Pi: hardware-service + dashboard + nginx)
Documentation=file:///opt/gate-system/README.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Change this path to where gate-system/ lives on the Pi.
WorkingDirectory=/opt/gate-system
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.edge.yml --project-directory . --env-file .env.edge up -d
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.edge.yml --project-directory . --env-file .env.edge down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
