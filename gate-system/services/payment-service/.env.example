SERVICE_NAME=payment-service
ENVIRONMENT=dev
LOG_LEVEL=INFO

JWT_SECRET=dev_only_change_me
JWT_ISSUER=gate-system
JWT_AUDIENCE=gate-system

POSTGRES_DSN=postgresql+asyncpg://gate:gate_password_change_me@postgres:5432/gate
REDIS_URL=redis://redis:6379/0

FINGERPRINTS_SERVICE_URL=http://fingerprints-service:8000

# Payment provider: mock (local dev) or nedarim (production).
PAYMENT_MODE=mock

# Nedarim Plus credit-card top-up (required when PAYMENT_MODE=nedarim).
# Mosad is the 7-digit institution number, ApiValid the 10-char verification text
# (both from the API keys screen). ApiPassword is deliberately not used: refunds
# and history sync are out of scope, so this service holds no data-pulling key.
NEDARIM_MOSAD=
NEDARIM_API_VALID=
# Category the top-ups are filed under in the Nedarim reports. Free text.
NEDARIM_GROUPE=

# Public HTTPS origin Nedarim posts the callback to. Must be reachable from
# 18.196.146.117 / 18.194.219.73. Use the Cloudflare Tunnel hostname, e.g.:
#   https://gate-pay.example.org
# or a quick-tunnel URL while smoke-testing:
#   https://xxxx.trycloudflare.com
PUBLIC_BASE_URL=

# When true, callbacks must include CF-Connecting-IP (set by Cloudflare).
# Keep true in production behind the tunnel; local unit tests inject the header.
NEDARIM_REQUIRE_CLOUDFLARE=true

# Exact Groupe that activates a Hebrew-month subscription via the institution webhook.
# Comparison is exact (no trim / fuzzy match).
NEDARIM_TARGET_GROUP=מנוי מקווה חודש

# Exact Groupe names that credit chip ledger balance via the institution webhook.
# Comma-separated; comparison is exact (no trim / fuzzy match).
NEDARIM_BALANCE_GROUP=ערך צבור למקווה

# Exact Groupe names that must never credit or activate a subscription.
# Comma-separated; comparison is exact. Deny wins over the allow lists.
NEDARIM_NOT_ALLOWED_GROUP=תרומה לבית הכנסת

# Skip IP + Cloudflare checks on POST /nedarim/webhook only. Ignored when
# ENVIRONMENT=production. Leave false except for local curl tests.
NEDARIM_WEBHOOK_ALLOW_LOCAL=false

# Amounts offered on the kiosk, in agorot. Anything else is rejected server-side.
TOPUP_AMOUNTS_CENTS=2000,5000,10000

# Fixed price for Hebrew-month subscription purchases (agorot). Default ₪300.
SUBSCRIPTION_PRICE_CENTS=30000
